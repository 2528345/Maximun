# Runtime profile: Lenovo 330s (i5, 8GB) - MVP production
# Objetivo: seguridad + estabilidad para operación diaria local/offline.

MAXIMUN_RUNTIME_PROFILE=lenovo330s_mvp_production
MAXIMUN_DATA_ROOT=/opt/maximun/data

# Seguridad MQTT (MVP prod)
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_TLS_PORT=8883
MQTT_USERNAME=maximun
MQTT_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_ALLOW_ANONYMOUS=false
MQTT_WS_ALLOW_ANONYMOUS=false
MQTT_TLS_ENABLE=true
MQTT_TLS_ALLOW_ANONYMOUS=false
MQTT_TLS_CA_FILE=/mosquitto/config/certs/ca.crt
MQTT_TLS_CERT_FILE=/mosquitto/config/certs/server.crt
MQTT_TLS_KEY_FILE=/mosquitto/config/certs/server.key
MQTT_ENFORCE_STRONG_PASSWORD=true
MQTT_ENABLE_ACL=true
MQTT_ENABLE_ADMIN_FALLBACK=false
MQTT_CORE_USERNAME=core
MQTT_CORE_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_AUDIO_USERNAME=audio
MQTT_AUDIO_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_VISION_USERNAME=vision
MQTT_VISION_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_RAG_USERNAME=rag
MQTT_RAG_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_IOT_USERNAME=iot
MQTT_IOT_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_DASHBOARD_USERNAME=dashboard
MQTT_DASHBOARD_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_OPS_USERNAME=ops
MQTT_OPS_PASSWORD=CAMBIAR_ESTA_CLAVE_SEGURA
MQTT_CLIENT_TLS_ENABLE=true
MQTT_TLS_CA_CERT=/certs/mqtt/ca.crt
MQTT_TLS_CLIENT_CERT=
MQTT_TLS_CLIENT_KEY=
MQTT_TLS_INSECURE=false
AUTOCHECK_INTERVAL_SEC=20
AUTOCHECK_AUTOSTART=true

# Seguridad base
MASTER_HASH=CAMBIAR_HASH_MAESTRO_UNICO
SIGNATURE_ENFORCEMENT=true
MODEL_CHECKSUM_FILE=/models_cache/model_checksums.sha256
FAILSAFE_EXEC_MODE=execute
FAILSAFE_HOLD_SECONDS=15
FAILSAFE_PODMAN_SERVICES=gateway-mqtt,audio-interface

# Modulos activos
ENABLE_UI=true
ENABLE_VISION=false
ENABLE_IOT=false

RAM_BUDGET_MB=7680
RESERVE_RAM_MB=1024

LLM_THREADS=4
LLM_BATCH=192

QWEN_CTX=2048
QWEN_MAX_TOKENS=160
QWEN_TEMPERATURE=0.3

DEEPSEEK_CTX=2048
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TEMPERATURE=0.1

GLM_CTX=3072
GLM_MAX_TOKENS=512
GLM_TEMPERATURE=0.2

# RAG
RAG_ENABLED=true
RAG_QUERY_TIMEOUT_SEC=3.5
RAG_TOP_K=3
RAG_MAX_DOC_CHARS=4000
RAG_STORAGE_ROOT=/rag_store
RAG_DOCS_PATH=/rag_store/docs
RAG_LOGS_PATH=/rag_store/logs
RAG_MODELS_PATH=/rag_store/models
RAG_RAM_CACHE_PATH=/dev/shm/maximun_rag_cache
RAG_SSD_BUDGET_GB=80
RAG_QUERY_CACHE_MAX=90
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=40
RAG_ALLOWED_EXTENSIONS=pdf,md,markdown,txt,rst
RAG_AUTO_INGEST_ON_BOOT=true
RAG_EMBED_BACKEND=sentence
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_EMBEDDING_LOCAL_ONLY=true
RAG_ENABLE_WEB_SCRAPING=false
RAG_QUERY_CACHE_TTL_SEC=900

# IoT (dejar desactivado hasta mapear puertos reales)
IOT_SIMULATION=true
IOT_ENABLE_BLUETOOTH=true
IOT_ENABLE_ZIGBEE=true
IOT_ENABLE_INDUSTRIAL=true
IOT_STATUS_INTERVAL_SEC=30
IOT_BLUETOOTH_TIMEOUT_SEC=5.0
IOT_ZIGBEE_SERIAL_PORT=/dev/ttyUSB1
IOT_ZIGBEE_BAUDRATE=115200
IOT_MODBUS_SERIAL_PORT=/dev/ttyUSB2
IOT_MODBUS_BAUDRATE=9600
IOT_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
IOT_OPCUA_DEFAULT_NODE=ns=2;i=2
IOT_CAN_CHANNEL=can0
IOT_CAN_INTERFACE=socketcan

# Vision/audio
MOONDREAM_ENABLED=false
RAM_INTERLOCK_MB=1800
VISION_REFLEX_INTERVAL_SEC=3
FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE_TYPE=int8
STT_CPU_THREADS=2
ARECORD_SECONDS=3
TTS_COOLDOWN_SEC=1.2

# Operacion y retencion
SMART_DEVICE=
SMART_CHECK_INTERVAL_SEC=600
CRITICAL_LOG_SOURCE=/rag_store/logs
CRITICAL_LOG_FALLBACK=/output/critical_logs_backup
ENGINEERING_FEEDBACK_LOG=/logs/engineering_feedback.jsonl
REWARD_MEMORY_PATH=/rag_store/reward_memory.jsonl
