# Runtime profile: Lenovo 330s (i5, 8GB) - Stable daily mode
# Focus: low RAM pressure, predictable latency, offline reliability.

MAXIMUN_RUNTIME_PROFILE=lenovo330s_stable
MAXIMUN_DATA_ROOT=/opt/maximun/data
ENABLE_UI=false
ENABLE_VISION=false

RAM_BUDGET_MB=7680
RESERVE_RAM_MB=1024

LLM_THREADS=4
LLM_BATCH=192

QWEN_CTX=2048
QWEN_MAX_TOKENS=160
QWEN_TEMPERATURE=0.3

DEEPSEEK_CTX=2048
DEEPSEEK_MAX_TOKENS=320
DEEPSEEK_TEMPERATURE=0.1

GLM_CTX=3072
GLM_MAX_TOKENS=512
GLM_TEMPERATURE=0.2

RAG_ENABLED=true
RAG_QUERY_TIMEOUT_SEC=3.5
RAG_TOP_K=3
RAG_MAX_DOC_CHARS=4000
RAG_STORAGE_ROOT=/rag_store
RAG_DOCS_PATH=/rag_store/docs
RAG_LOGS_PATH=/rag_store/logs
RAG_MODELS_PATH=/rag_store/models
RAG_RAM_CACHE_PATH=/dev/shm/maximun_rag_cache
RAG_SSD_BUDGET_GB=80
RAG_QUERY_CACHE_MAX=90
RAG_CHUNK_SIZE_WORDS=180
RAG_CHUNK_OVERLAP_WORDS=40
RAG_ALLOWED_EXTENSIONS=pdf,md,markdown,txt,rst
RAG_AUTO_INGEST_ON_BOOT=true
RAG_EMBED_BACKEND=hash
RAG_ENABLE_WEB_SCRAPING=false
RAG_QUERY_CACHE_TTL_SEC=900

MOONDREAM_ENABLED=false
RAM_INTERLOCK_MB=1800
VISION_REFLEX_INTERVAL_SEC=3

FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE_TYPE=int8
STT_CPU_THREADS=2
ARECORD_SECONDS=3
TTS_COOLDOWN_SEC=1.2

SIGNATURE_ENFORCEMENT=true
MODEL_CHECKSUM_FILE=/models_cache/model_checksums.sha256
FAILSAFE_EXEC_MODE=notify
FAILSAFE_HOLD_SECONDS=15
FAILSAFE_PODMAN_SERVICES=gateway-mqtt,audio-interface
SMART_DEVICE=
SMART_CHECK_INTERVAL_SEC=600
CRITICAL_LOG_SOURCE=/rag_store/logs
CRITICAL_LOG_FALLBACK=/output/critical_logs_backup
ENGINEERING_FEEDBACK_LOG=/logs/engineering_feedback.jsonl
REWARD_MEMORY_PATH=/rag_store/reward_memory.jsonl
