# Security seed
MASTER_HASH=4f8a9b1c2d3e4f5a6b7c8d9e0f1a2b3c4d5e6f7a8b9c0d1e2f3a4b5c6d7e8f9

# Host storage root (set this to your SSD mount if needed)
MAXIMUN_DATA_ROOT=/opt/maximun/data

# Runtime profile
MAXIMUN_RUNTIME_PROFILE=lenovo330s_stable
ENABLE_UI=false
ENABLE_VISION=false
ENABLE_IOT=false

# Optional runtime toggles
RAG_ENABLED=true
RAG_QUERY_TIMEOUT_SEC=4.0
RAG_TOP_K=4
RAG_MAX_DOC_CHARS=6000
RAG_STORAGE_ROOT=/rag_store
RAG_DOCS_PATH=/rag_store/docs
RAG_LOGS_PATH=/rag_store/logs
RAG_MODELS_PATH=/rag_store/models
RAG_RAM_CACHE_PATH=/dev/shm/maximun_rag_cache
RAG_SSD_BUDGET_GB=80
RAG_QUERY_CACHE_MAX=120
RAG_CHUNK_SIZE_WORDS=220
RAG_CHUNK_OVERLAP_WORDS=50
RAG_ALLOWED_EXTENSIONS=pdf,md,markdown,txt,rst
RAG_AUTO_INGEST_ON_BOOT=true
RAG_EMBED_BACKEND=hash
RAG_EMBEDDING_MODEL=all-MiniLM-L6-v2
RAG_ENABLE_WEB_SCRAPING=false
RAG_QUERY_CACHE_TTL_SEC=900

IOT_SIMULATION=true
IOT_ENABLE_BLUETOOTH=true
IOT_ENABLE_ZIGBEE=true
IOT_ENABLE_INDUSTRIAL=true
IOT_STATUS_INTERVAL_SEC=25
IOT_BLUETOOTH_TIMEOUT_SEC=6.0
IOT_ZIGBEE_SERIAL_PORT=/dev/ttyUSB1
IOT_ZIGBEE_BAUDRATE=115200
IOT_MODBUS_SERIAL_PORT=/dev/ttyUSB2
IOT_MODBUS_BAUDRATE=9600
IOT_OPCUA_ENDPOINT=opc.tcp://127.0.0.1:4840
IOT_OPCUA_DEFAULT_NODE=ns=2;i=2
IOT_CAN_CHANNEL=can0
IOT_CAN_INTERFACE=socketcan

RAM_BUDGET_MB=8192
RESERVE_RAM_MB=512
LLM_THREADS=4
LLM_BATCH=256

GLM_CTX=4096
GLM_MAX_TOKENS=768
DEEPSEEK_MAX_TOKENS=420
QWEN_MAX_TOKENS=180

MOONDREAM_ENABLED=true
RAM_INTERLOCK_MB=1536
VISION_REFLEX_INTERVAL_SEC=2

FASTER_WHISPER_MODEL=small
FASTER_WHISPER_COMPUTE_TYPE=int8
STT_CPU_THREADS=4

# If using GPU in future, set *_N_GPU_LAYERS > 0
QWEN_N_GPU_LAYERS=0
DEEPSEEK_N_GPU_LAYERS=0
GLM_N_GPU_LAYERS=0
MOONDREAM_N_GPU_LAYERS=0

# Integrity and failsafe
SIGNATURE_ENFORCEMENT=true
MODEL_CHECKSUM_FILE=/models_cache/model_checksums.sha256
FAILSAFE_EXEC_MODE=notify
FAILSAFE_HOLD_SECONDS=15
FAILSAFE_PODMAN_SERVICES=gateway-mqtt,audio-interface
SMART_DEVICE=
SMART_CHECK_INTERVAL_SEC=600
CRITICAL_LOG_SOURCE=/rag_store/logs
CRITICAL_LOG_FALLBACK=/output/critical_logs_backup
ENGINEERING_FEEDBACK_LOG=/logs/engineering_feedback.jsonl
REWARD_MEMORY_PATH=/rag_store/reward_memory.jsonl
