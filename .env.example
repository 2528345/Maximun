# MQTT Configuration
MQTT_HOST=mqtt
MQTT_PORT=1883
MQTT_USER=vr_user
MQTT_PASSWORD=secure_password_123

# Audio Configuration
VOSK_MODEL_PATH=/app/data/models/vosk
PIPER_TTS_PATH=/app/data/models/piper
AUDIO_SAMPLE_RATE=16000

# Vision Configuration
FACENET_MODEL_PATH=/app/data/models/facenet
YOLO_MODEL_PATH=/app/data/models/yolo
FACE_RECOGNITION_THRESHOLD=0.6

# AI Models
TINYLLAMA_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
PHI3_MODEL=microsoft/phi-3-mini-4k-instruct
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# RAG Configuration
CHROMADB_PATH=/app/rag_db
RAG_TOP_K=3
RAG_SIMILARITY_THRESHOLD=0.7

# Learning Configuration
LEARNING_DB_PATH=/app/learning_db
ERROR_ANALYSIS_ENABLED=true
CONTINUOUS_LEARNING_ENABLED=true

# Hardware Configuration
GPIO_ENABLED=true
SERIAL_ENABLED=true
BLUETOOTH_ENABLED=true
ZIGBEE_ENABLED=true
ESP32_ENABLED=true

# System Configuration
LOG_LEVEL=INFO
MAX_WORKERS=4
TIMEOUT_SECONDS=30
DEBUG_MODE=false

# Monitoring
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Security
ENABLE_SSL=true
SSL_CERT_PATH=/app/config/cert.pem
SSL_KEY_PATH=/app/config/key.pem

# Performance
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
BATCH_PROCESSING=true
BATCH_SIZE=32
